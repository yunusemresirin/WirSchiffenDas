@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam sequenceMessageAlign center
hide footbox
participant "Web UI" as UI
participant "Management" as M
participant "Configuration" as C
participant "Fluid" as F
participant "Thermal" as T
participant "Electrical" as E
participant "Engine" as EM
UI -> M : POST Analyse
M -> C : Konfiguration lesen
C --> M : Konfiguration
M -> M : Lauf + attemptId speichern
M -> F : Command(analysisId, attemptId)
F --> M : 202 Accepted
M --> UI : 202 + analysisId
note over F, EM : Berechnung asynchron; HTTP-Aufrufe synchron
F -> M : RUNNING
F -> F : Öl / Kraftstoff prüfen
F -> M : READY/OK + 2 Resultate
M --> F : 204
F -> T : Command + FLUID=OK
T --> F : 202
T -> M : RUNNING
T -> T : Kühlung prüfen
T -> M : READY/OK + Resultat
M --> T : 204
T -> E : Command + Vorgänger
E --> T : 202
E -> M : RUNNING
E -> E : Elektrik prüfen
E -> M : READY/OK + Resultat
M --> E : 204
E -> EM : Command + 3 Vorgänger
EM --> E : 202
EM -> M : RUNNING
EM -> EM : 3 Vorgänger + Motorsteuerung prüfen
EM -> M : READY/OK + Resultat
M -> M : Gesamt-OK nur bei Vollständigkeit
UI -> M : Status abrufen
M --> UI : 4 Schritte / 5 Equipmentresultate
@enduml
