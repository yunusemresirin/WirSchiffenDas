@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
top to bottom direction
actor "Ingenieur" as Engineer
actor "Demo-Operator" as Operator
rectangle "WirSchiffenDas\nAnalyseprototyp" {
  usecase "Konfiguration\nspeichern / laden" as Configuration
  usecase "Analyse starten" as Start
  usecase "Fortschritt und\nEquipmentresultate lesen" as Read
  usecase "Fehlgeschlagenen\nSchritt wiederholen" as Retry
  usecase "Betriebszustand\nbeobachten" as Monitor
}
Engineer --> Configuration
Engineer --> Start
Engineer --> Read
Engineer --> Retry
Operator --> Monitor
note bottom of Read
  Bedienung: Browser mit Web UI
  Alternativ: REST-Client / Postman
end note
note bottom of Monitor
  Operator stoppt/startet Container
  über Docker außerhalb der Fach-API.
end note
@enduml
