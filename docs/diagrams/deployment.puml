@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
top to bottom direction
node "Arbeitsplatz" as Client {
  artifact "Browser / React" as Browser
}
node "Ein Docker-Host · Compose-Netzwerk" as Host {
  node "web-ui\nNginx :80" as UI
  node "configuration-service\nSpring Boot :8081" as C
  node "analysis-management-service\nSpring Boot :8082" as M
  frame "Vier separate Worker-Container" as W {
    node "fluid-analysis-service\n:8083" as F
    node "thermal-analysis-service\n:8084" as T
    node "electrical-analysis-service\n:8085" as E
    node "engine-management-analysis-service\n:8086" as EM
    F -[hidden]right- T
    E -[hidden]right- EM
    F -[hidden]down- E
    T -[hidden]down- EM
  }
  database "Volume configuration-data\nH2-Datei" as CD
  database "Volume analysis-data\nH2-Datei" as MD
}
Browser --> UI : HTTP localhost:3000
UI --> C : REST / DNS
UI --> M : REST / DNS
C --> CD : /app/data
M --> MD : /app/data
M --> W : Anker / Retry
W --> M : Callbacks
note bottom of W
  Interne REST-Kette: F → T → E → EM
  Backendports 8081–8086 auch am Host
  Readiness-Checks für alle Backends
end note
@enduml
