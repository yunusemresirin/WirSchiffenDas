@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam componentStyle rectangle
skinparam packageStyle rectangle
top to bottom direction
component "Web UI\nReact / Nginx" as UI
component "Configuration\nAPI / Anwendung / Domäne" as C
component "Analysis Management\nAPI / Anwendung / Domäne" as M
database "Configuration DB" as CD
database "Analysis DB" as MD
package "Analyse-Worker" as Workers {
  component "Fluid\nÖl + Kraftstoff" as F
  component "Thermal\nKühlung" as T
  component "Electrical\nElektrik" as E
  component "Engine Management\nMotorsteuerung + Vorgänger" as EM
  F --> T : REST-Command
  T --> E : REST-Command
  E --> EM : REST-Command
}
UI --> C : REST
UI --> M : REST
M --> C : Konfiguration lesen
C --> CD : JPA
M --> MD : JPA
M --> F : Ankerstart
M ..> Workers : Retry an Ziel
Workers --> M : Status / Ergebnisse
note right of Workers
  Jeder Worker meldet an Management.
  Keine eigene Datenbank.
  Lokale Deduplikation im RAM.
end note
note top of UI
  Monitoring über Nginx
  zu allen sechs Backends
end note
@enduml
