{
  "info": {
    "name": "WirSchiffenDas – Engine Quality Analysis",
    "description": "Postman-Collection für den PoC. Happy Path: 01 -> 02 -> 03 -> 04. Fehlerdemo: `docker compose stop thermal-analysis-service`, dann 01 und 03 ausführen, einige Sekunden warten, 04 prüfen, anschließend `docker compose start thermal-analysis-service` und 05 ausführen.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "configurationBaseUrl", "value": "http://localhost:8081"},
    {"key": "analysisBaseUrl", "value": "http://localhost:8082"},
    {"key": "configurationId", "value": ""},
    {"key": "analysisId", "value": ""},
    {"key": "retryAlgorithm", "value": "THERMAL"}
  ],
  "item": [
    {
      "name": "01 Create Configuration",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"oilSystem\": \"STANDARD\",\n  \"fuelSystem\": \"PREMIUM\",\n  \"coolingSystem\": \"STANDARD\",\n  \"electricalSystem\": \"PREMIUM\",\n  \"engineManagementSystem\": \"ADVANCED\"\n}"},
        "url": "{{configurationBaseUrl}}/api/configurations"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.collectionVariables.set('configurationId', body.configurationId);"]}}]
    },
    {
      "name": "02 Get Configuration",
      "request": {"method": "GET", "url": "{{configurationBaseUrl}}/api/configurations/{{configurationId}}"}
    },
    {
      "name": "03 Start Analysis",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"configurationId\": \"{{configurationId}}\"\n}"},
        "url": "{{analysisBaseUrl}}/api/analyses"
      },
      "event": [{"listen": "test", "script": {"exec": ["pm.test('202 Accepted', () => pm.response.to.have.status(202));", "const body = pm.response.json();", "pm.collectionVariables.set('analysisId', body.analysisId);"]}}]
    },
    {
      "name": "04 Get Analysis Status / Result",
      "request": {"method": "GET", "url": "{{analysisBaseUrl}}/api/analyses/{{analysisId}}"}
    },
    {
      "name": "05 Retry Failed Algorithm",
      "request": {"method": "POST", "url": "{{analysisBaseUrl}}/api/analyses/{{analysisId}}/algorithms/{{retryAlgorithm}}/retry"}
    },
    {
      "name": "06 Configuration Health",
      "request": {"method": "GET", "url": "{{configurationBaseUrl}}/actuator/health"}
    },
    {
      "name": "07 Analysis Management Health",
      "request": {"method": "GET", "url": "{{analysisBaseUrl}}/actuator/health"}
    }
  ]
}
